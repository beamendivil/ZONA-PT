# Public browser configuration. Never put secrets or patient data in VITE_ values.

# Relative path or absolute URL for the future API. Defaults to /api.
VITE_API_URL=/api

# Demo password authentication defaults on in development and off in production.
# Production builds reject an explicit value of true.
VITE_ENABLE_DEMO_AUTH=true

# Development-only component inspector. It is never included in production.
VITE_ENABLE_INSPECTOR=true

# Clerk identity. Leave unset to retain development-only demo authentication.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Server-only synthetic Stage 2 API. Never prefix these with VITE_.
# This API is hard-disabled when VERCEL_ENV=production.
ENABLE_SYNTHETIC_API=false
DATABASE_URL=postgresql://user:password@localhost:5432/zona_pt

# Server-only HMAC secret for the approved scheduling provider's webhooks.
SCHEDULING_WEBHOOK_SECRET=replace-with-at-least-32-random-bytes

# Production PHI remains blocked until all evidence IDs are approved records.
PHI_PRODUCTION_ENABLED=false
CLINIC_APPROVAL_ID=
VENDOR_BAA_REVIEW_ID=
RESTORE_TEST_EVIDENCE_ID=
SECURITY_RISK_REVIEW_ID=
